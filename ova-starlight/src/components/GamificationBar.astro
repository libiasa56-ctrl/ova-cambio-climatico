---
// GamificationBar.astro: Barra Gamificada Flotante de Progreso, Puntos y Nivel
---

<div class="gamification-bar not-content mb-6 p-3.5 rounded-xl border border-[#2e2e32] bg-[#202127] shadow-sm flex flex-wrap items-center justify-between gap-3 select-none">
  <!-- Puntos y Estrellas -->
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-xl">
      ⭐
    </div>
    <div>
      <div class="flex items-center gap-2">
        <span id="gamification-score" class="text-base font-black text-amber-400 font-mono tracking-tight">0 pts</span>
        <span id="gamification-level-badge" class="text-[10px] font-bold uppercase px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
          Novato Climático
        </span>
      </div>
      <p class="text-[11px] text-slate-300 m-0">Gana puntos en los simuladores, quizzes y juegos</p>
    </div>
  </div>

  <!-- Barra de Nivel -->
  <div class="flex items-center gap-3 flex-1 max-w-xs">
    <div class="w-full bg-[#252529] h-2.5 rounded-full overflow-hidden border border-[#2e2e32]">
      <div id="gamification-progress-fill" class="h-full bg-gradient-to-r from-indigo-500 via-emerald-400 to-amber-400 rounded-full transition-all duration-500" style="width: 15%;"></div>
    </div>
    <span id="gamification-progress-pct" class="text-xs font-mono font-bold text-slate-200">15%</span>
  </div>

  <!-- Acceso Rápido al Diploma -->
  <div class="flex items-center gap-2">
    <a href="/evaluacion/pasaporte-climatico/" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[#646cff] hover:bg-[#747bff] text-white transition-all flex items-center gap-1.5 shadow-sm no-underline">
      <span>🎓</span> <span>Mi Pasaporte</span>
    </a>
  </div>
</div>

<script>
  function updateGamificationWidget() {
    const scoreEl = document.getElementById('gamification-score');
    const badgeEl = document.getElementById('gamification-level-badge');
    const fillEl = document.getElementById('gamification-progress-fill');
    const pctEl = document.getElementById('gamification-progress-pct');

    const score = parseInt(localStorage.getItem('ova_clima_score') || '0', 10);
    const maxScore = 240;
    const pct = Math.min(100, Math.round((score / maxScore) * 100));

    if (scoreEl) scoreEl.textContent = `${score} pts`;
    if (fillEl) fillEl.style.width = `${Math.max(8, pct)}%`;
    if (pctEl) pctEl.textContent = `${pct}%`;

    if (badgeEl) {
      if (score >= 200) {
        badgeEl.textContent = '🌟 Líder Climático';
        badgeEl.className = 'text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40';
      } else if (score >= 140) {
        badgeEl.textContent = '🏔️ Defensor del Páramo';
        badgeEl.className = 'text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40';
      } else if (score >= 80) {
        badgeEl.textContent = '⚖️ Negociador COP';
        badgeEl.className = 'text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-sky-500/20 text-sky-300 border border-sky-500/40';
      } else if (score >= 30) {
        badgeEl.textContent = '🔍 Detective del Clima';
        badgeEl.className = 'text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-teal-500/20 text-teal-300 border border-teal-500/40';
      } else {
        badgeEl.textContent = '🌱 Cadete Ambiental';
        badgeEl.className = 'text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-slate-700/60 text-slate-300 border border-slate-600';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', updateGamificationWidget);
  document.addEventListener('astro:page-load', updateGamificationWidget);
  window.addEventListener('storage', updateGamificationWidget);
  updateGamificationWidget();
</script>
