---
// MemoryGame.astro: Juego Interactivo de Memoria 3D de Economía Ecológica
---

<div class="not-content my-8 p-6 rounded-xl border border-[#2e2e32] bg-[#202127] shadow-sm memory-game">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-[#2e2e32]">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 uppercase tracking-wider">
          Gamificación en el Aula
        </span>
        <span class="text-xs text-[#a1a1aa]">Conceptos de Economía Ecológica</span>
      </div>
      <h3 class="text-xl font-bold text-white m-0">Desafío Mental: Emparejamiento 3D de Conceptos Clave</h3>
      <p class="text-xs text-[#ebebf5] mt-1 mb-0">Encuentra las 4 parejas conceptuales volteando las cartas interactivas</p>
    </div>
    <div class="flex items-center gap-3">
      <div class="text-xs font-bold px-3 py-1.5 rounded-xl bg-[#161618] text-indigo-400 border border-[#2e2e32]">
        Intentos: <span id="mem-moves" class="font-mono text-white">0</span>
      </div>
      <button type="button" id="btn-reset-memory" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-[#161618] hover:bg-[#252529] hover:border-[#646cff] border border-[#2e2e32] text-[#ebebf5] transition-all cursor-pointer">
        🔄 Reiniciar
      </button>
    </div>
  </div>

  <!-- Tablero 4x2 de Cartas 3D -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl mx-auto mb-6" id="memory-board">
    <!-- Las cartas se generarán dinámicamente con JavaScript -->
  </div>

  <!-- Notificación de Victoria -->
  <div id="memory-win-box" class="hidden p-5 rounded-xl bg-[#161618] border border-emerald-500/50 text-center animate-fade-in">
    <span class="text-4xl block mb-2">🎉</span>
    <h4 class="text-base font-bold text-emerald-300 m-0">¡EXCELENTE MEMORIA CONCEPTUAL!</h4>
    <p class="text-xs text-[#ebebf5] mt-1 mb-3">
      Has emparejado todos los conceptos fundamentales de economía ecológica y justicia territorial.
    </p>
    <div class="inline-block px-4 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/40 text-emerald-200 text-xs font-bold">
      ⭐ +25 Puntos acreditados a tu Pasaporte
    </div>
  </div>
</div>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    backface-visibility: hidden;
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }
</style>

<script>
  function setupMemoryGame() {
    const cardsData = [
      { id: 1, pair: 'A', title: 'Deuda Ecológica', icon: '⚖️', desc: 'Concepto Económico' },
      { id: 2, pair: 'A', title: 'Norte Global emitió más del 50% histórico', icon: '🏭', desc: 'Definición Fáctica' },
      { id: 3, pair: 'B', title: 'Greenwashing', icon: '🍃', desc: 'Práctica Corporativa' },
      { id: 4, pair: 'B', title: 'Publicidad engañosa para no reducir fósiles', icon: '📢', desc: 'Definición Fáctica' },
      { id: 5, pair: 'C', title: 'Páramos de Ipiales', icon: '🏔️', desc: 'Ecosistema Andino' },
      { id: 6, pair: 'C', title: 'Fábricas de agua dulce y recarga hídrica', icon: '💧', desc: 'Función Vital' },
      { id: 7, pair: 'D', title: 'Soberanía Energética', icon: '☀️', desc: 'Modelo Comunitario' },
      { id: 8, pair: 'D', title: 'Micro-redes limpias gestionadas por la gente', icon: '🤝', desc: 'Alternativa Real' }
    ];

    const board = document.getElementById('memory-board');
    const movesEl = document.getElementById('mem-moves');
    const winBox = document.getElementById('memory-win-box');
    const btnReset = document.getElementById('btn-reset-memory');

    if (!board) return;

    let flippedCards: HTMLElement[] = [];
    let matchedPairs = 0;
    let moves = 0;
    let isLocked = false;

    function playTone(freq: number, dur: number) {
      try {
        const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(0.12, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);
        osc.start();
        osc.stop(ctx.currentTime + dur);
      } catch (e) {}
    }

    function initBoard() {
      board!.innerHTML = '';
      flippedCards = [];
      matchedPairs = 0;
      moves = 0;
      isLocked = false;
      if (movesEl) movesEl.textContent = '0';
      if (winBox) winBox.classList.add('hidden');

      // Mezclar cartas
      const shuffled = [...cardsData].sort(() => Math.random() - 0.5);

      shuffled.forEach((item) => {
        const cardWrapper = document.createElement('div');
        cardWrapper.className = 'perspective-1000 h-28 cursor-pointer select-none';

        cardWrapper.innerHTML = `
          <div class="card-inner relative w-full h-full transform-style-3d transition-transform duration-500 rounded-xl shadow-sm border border-[#2e2e32] bg-[#161618]" data-pair="${item.pair}">
            <!-- Frente (Oculto al inicio) -->
            <div class="card-front absolute w-full h-full backface-hidden rounded-xl bg-[#161618] border border-[#2e2e32] flex flex-col items-center justify-center p-2 text-center">
              <span class="text-2xl mb-1">🌍</span>
              <span class="text-[10px] font-bold text-[#a1a1aa] uppercase tracking-wider">¿Par?</span>
            </div>
            <!-- Reverso (Concepto) -->
            <div class="card-back absolute w-full h-full backface-hidden rotate-y-180 rounded-xl bg-[#202127] border-2 border-[#646cff] flex flex-col items-center justify-center p-2 text-center">
              <span class="text-xl mb-0.5">${item.icon}</span>
              <strong class="text-[11px] font-bold text-white leading-tight line-clamp-2">${item.title}</strong>
              <span class="text-[9px] text-indigo-300 font-semibold mt-0.5">${item.desc}</span>
            </div>
          </div>
        `;

        cardWrapper.addEventListener('click', () => {
          const inner = cardWrapper.querySelector('.card-inner') as HTMLElement;
          if (!inner || isLocked || inner.classList.contains('rotate-y-180') || inner.getAttribute('data-matched') === 'true') {
            return;
          }

          // Voltear carta
          inner.classList.add('rotate-y-180');
          flippedCards.push(inner);
          playTone(440, 0.15); // La4

          if (flippedCards.length === 2) {
            moves++;
            if (movesEl) movesEl.textContent = moves.toString();
            checkMatch();
          }
        });

        board!.appendChild(cardWrapper);
      });
    }

    function checkMatch() {
      isLocked = true;
      const [c1, c2] = flippedCards;
      const pair1 = c1.getAttribute('data-pair');
      const pair2 = c2.getAttribute('data-pair');

      if (pair1 === pair2) {
        // Acierto
        c1.setAttribute('data-matched', 'true');
        c2.setAttribute('data-matched', 'true');
        c1.classList.add('ring-2', 'ring-emerald-400');
        c2.classList.add('ring-2', 'ring-emerald-400');
        playTone(659.25, 0.3); // Mi5 acierto

        matchedPairs++;
        flippedCards = [];
        isLocked = false;

        if (matchedPairs === 4) {
          setTimeout(() => {
            if (winBox) winBox.classList.remove('hidden');
            playTone(880, 0.5); // La5 fanfarria
            const currentScore = parseInt(localStorage.getItem('ova_clima_score') || '0', 10);
            localStorage.setItem('ova_clima_score', (currentScore + 25).toString());
          }, 400);
        }
      } else {
        // Fallo
        setTimeout(() => {
          c1.classList.remove('rotate-y-180');
          c2.classList.remove('rotate-y-180');
          flippedCards = [];
          isLocked = false;
        }, 900);
      }
    }

    btnReset?.addEventListener('click', initBoard);
    initBoard();
  }

  document.addEventListener('DOMContentLoaded', setupMemoryGame);
  document.addEventListener('astro:page-load', setupMemoryGame);
  setupMemoryGame();
</script>
