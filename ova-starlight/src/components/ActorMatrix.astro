---
// ActorMatrix.astro: Matriz Visual Interactiva de Actores Geopolíticos y Corporativos
---

<div class="not-content my-8 p-6 rounded-xl border border-[#2e2e32] bg-[#202127] shadow-sm actor-matrix">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-[#2e2e32]">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 uppercase tracking-widest">
          Explorador de Actores
        </span>
        <span class="text-xs text-slate-400">¿Quién tiene el poder?</span>
      </div>
      <h3 class="text-xl font-bold text-white m-0">Matriz de Actores Globales: Intereses vs. Responsabilidad</h3>
      <p class="text-xs text-slate-300 mt-1 mb-0">Haz clic en cada actor para contrastar su discurso oficial con sus emisiones empíricas</p>
    </div>
    <div class="text-xs font-bold px-3 py-1.5 rounded-xl bg-[#161618] text-indigo-400 border border-[#2e2e32]">
      5 Actores Clave Mapeados
    </div>
  </div>

  <!-- Cuadrícula de Actores -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
    <!-- Actor 1: EE.UU. & Bloque Occidental -->
    <div class="actor-card p-4 rounded-xl border border-[#2e2e32] bg-[#161618] hover:border-[#646cff] hover:bg-[#202127] transition-all cursor-pointer shadow-sm" data-actor="usa">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-12 h-12 rounded-xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-2xl">
          🏭
        </div>
        <div>
          <h4 class="text-sm font-bold text-white m-0">Estados Unidos</h4>
          <span class="text-[11px] text-indigo-400 font-semibold">Mayor Emisor Histórico Acumulado</span>
        </div>
      </div>
      <div class="space-y-1.5 text-xs text-[#ebebf5]">
        <div class="flex justify-between">
          <span class="text-[#a1a1aa]">Emisiones Históricas:</span>
          <strong class="text-rose-400 font-mono">24.5% Global</strong>
        </div>
        <div class="flex justify-between">
          <span class="text-[#a1a1aa]">Emisión Per Cápita:</span>
          <strong class="text-amber-300 font-mono">14.9 t CO2/año</strong>
        </div>
      </div>
      <div class="mt-3 pt-2.5 border-t border-[#2e2e32] text-[11px] text-indigo-400 font-semibold flex items-center justify-between">
        <span>Ver Interés Oculto</span> <span>➔</span>
      </div>
    </div>

    <!-- Actor 2: China & Emergentes -->
    <div class="actor-card p-4 rounded-xl border border-[#2e2e32] bg-[#161618] hover:border-[#646cff] hover:bg-[#202127] transition-all cursor-pointer shadow-sm" data-actor="china">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-12 h-12 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-2xl">
          🏗️
        </div>
        <div>
          <h4 class="text-sm font-bold text-white m-0">China e India</h4>
          <span class="text-[11px] text-amber-400 font-semibold">Fábrica Manufacturera Mundial</span>
        </div>
      </div>
      <div class="space-y-1.5 text-xs text-[#ebebf5]">
        <div class="flex justify-between">
          <span class="text-[#a1a1aa]">Emisiones Anuales:</span>
          <strong class="text-rose-400 font-mono">~30% Actual</strong>
        </div>
        <div class="flex justify-between">
          <span class="text-[#a1a1aa]">Emisión Per Cápita:</span>
          <strong class="text-emerald-300 font-mono">8.0 t CO2/año</strong>
        </div>
      </div>
      <div class="mt-3 pt-2.5 border-t border-[#2e2e32] text-[11px] text-amber-300 font-semibold flex items-center justify-between">
        <span>Ver Interés Oculto</span> <span>➔</span>
      </div>
    </div>

    <!-- Actor 3: Países Andinos / Colombia / Nariño -->
    <div class="actor-card p-4 rounded-xl border border-[#2e2e32] bg-[#161618] hover:border-[#646cff] hover:bg-[#202127] transition-all cursor-pointer shadow-sm" data-actor="narino">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-2xl">
          🏔️
        </div>
        <div>
          <h4 class="text-sm font-bold text-white m-0">Colombia y Nariño</h4>
          <span class="text-[11px] text-emerald-400 font-semibold">Custodios de Páramos y Agua</span>
        </div>
      </div>
      <div class="space-y-1.5 text-xs text-[#ebebf5]">
        <div class="flex justify-between">
          <span class="text-[#a1a1aa]">Emisiones Globales:</span>
          <strong class="text-emerald-400 font-mono">&lt; 0.6% Anual</strong>
        </div>
        <div class="flex justify-between">
          <span class="text-[#a1a1aa]">Vulnerabilidad:</span>
          <strong class="text-rose-400 font-mono">Crítica (Glaciares)</strong>
        </div>
      </div>
      <div class="mt-3 pt-2.5 border-t border-[#2e2e32] text-[11px] text-emerald-300 font-semibold flex items-center justify-between">
        <span>Ver Reclamo Territorial</span> <span>➔</span>
      </div>
    </div>

    <!-- Actor 4: Multinacionales Petroleras -->
    <div class="actor-card p-4 rounded-xl border border-[#2e2e32] bg-[#161618] hover:border-[#646cff] hover:bg-[#202127] transition-all cursor-pointer shadow-sm" data-actor="oil">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-12 h-12 rounded-xl bg-purple-500/15 border border-purple-500/30 flex items-center justify-center text-2xl">
          🛢️
        </div>
        <div>
          <h4 class="text-sm font-bold text-white m-0">Grandes Petroleras</h4>
          <span class="text-[11px] text-purple-400 font-semibold">Las 'Carbon Majors'</span>
        </div>
      </div>
      <div class="space-y-1.5 text-xs text-[#ebebf5]">
        <div class="flex justify-between">
          <span class="text-[#a1a1aa]">Responsabilidad:</span>
          <strong class="text-rose-400 font-mono">71% de Emisiones</strong>
        </div>
        <div class="flex justify-between">
          <span class="text-[#a1a1aa]">Estrategia:</span>
          <strong class="text-amber-300 font-mono">Greenwashing</strong>
        </div>
      </div>
      <div class="mt-3 pt-2.5 border-t border-[#2e2e32] text-[11px] text-purple-300 font-semibold flex items-center justify-between">
        <span>Ver Interés Oculto</span> <span>➔</span>
      </div>
    </div>

    <!-- Actor 5: Comunidades Indígenas y Juventud -->
    <div class="actor-card p-4 rounded-xl border border-[#2e2e32] bg-[#161618] hover:border-[#646cff] hover:bg-[#202127] transition-all cursor-pointer shadow-sm" data-actor="community">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-12 h-12 rounded-xl bg-teal-500/15 border border-teal-500/30 flex items-center justify-center text-2xl">
          🌿
        </div>
        <div>
          <h4 class="text-sm font-bold text-white m-0">Comunidades & Jóvenes</h4>
          <span class="text-[11px] text-teal-400 font-semibold">Defensa Intergeneracional</span>
        </div>
      </div>
      <div class="space-y-1.5 text-xs text-[#ebebf5]">
        <div class="flex justify-between">
          <span class="text-[#a1a1aa]">Territorios Protegidos:</span>
          <strong class="text-emerald-400 font-mono">80% Biodiversidad</strong>
        </div>
        <div class="flex justify-between">
          <span class="text-[#a1a1aa]">Exigencia:</span>
          <strong class="text-indigo-400 font-mono">Justicia Climática</strong>
        </div>
      </div>
      <div class="mt-3 pt-2.5 border-t border-[#2e2e32] text-[11px] text-teal-300 font-semibold flex items-center justify-between">
        <span>Ver Propuesta</span> <span>➔</span>
      </div>
    </div>
  </div>

  <!-- Panel Desplegable de Detalles del Actor Seleccionado -->
  <div id="actor-detail-box" class="p-5 rounded-xl bg-[#161618] border border-[#2e2e32] text-[#ebebf5]">
    <div class="flex items-center justify-between mb-3">
      <h4 id="actor-detail-title" class="text-base font-bold text-[#646cff] m-0">Selecciona un actor arriba para ver su expediente</h4>
      <span id="actor-detail-tag" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#202127] text-indigo-300 border border-[#2e2e32] uppercase">Expediente</span>
    </div>
    <p id="actor-detail-text" class="text-xs leading-relaxed text-[#ebebf5] m-0">
      Cada actor desempeña un rol desigual en la economía del carbono. Al hacer clic en las tarjetas podrás contrastar sus discursos de relaciones públicas frente a sus datos reales de extracción e impacto territorial.
    </p>
  </div>
</div>

<script>
  function setupActorMatrix() {
    const details: Record<string, { title: string; tag: string; text: string }> = {
      usa: {
        title: 'Estados Unidos y Bloque Industrializado Histórico',
        tag: 'Deuda Ecológica del Norte',
        text: 'Aunque solo representan el 4% de la población mundial, consumen desproporcionadamente recursos y han emitido casi un cuarto de todo el CO2 histórico. Su estrategia en la COP es defender patentes privadas de tecnologías limpias y condicionar el financiamiento a préstamos bancarios en vez de transferencias directas no reembolsables.'
      },
      china: {
        title: 'China e India: Dilema del Desarrollo Contemporáneo',
        tag: 'Fábrica del Planeta',
        text: 'Son los mayores emisores anuales hoy porque fabrican los bienes y tecnologías que consume el mundo occidental. Argumentan con legitimidad histórica que su emisión acumulada por habitante es muy inferior a la de EE.UU. o Europa, y exigen plazos más amplios para desmantelar sus centrales de carbón.'
      },
      narino: {
        title: 'Colombia, Cuenca del Guáitara y Páramos de Ipiales',
        tag: 'Víctima y Protector del Territorio',
        text: 'Con una huella de carbono inferior al 0.6%, Colombia soporta desastres extremos: sequías en los páramos de Nariño que abastecen de agua potable a Ipiales y Túquerres. La exigencia ciudadana es la no explotación de hidrocarburos en zonas de reserva hídrica y la financiación internacional para la preservación de los bosques andinos.'
      },
      oil: {
        title: 'Grandes Corporaciones de Hidrocarburos (Carbon Majors)',
        tag: 'Interés Extractivista',
        text: 'Solo 100 empresas petroleras y carboníferas son responsables del 71% de las emisiones industriales mundiales desde 1988. Gastan millones de dólares en publicidad engañosa (greenwashing) promoviendo compensaciones forestales para no cesar la extracción ni desmantelar sus refinerías.'
      },
      community: {
        title: 'Pueblos Originarios, Campesinos y Juventud',
        tag: 'Soberanía y Resistencia',
        text: 'Los pueblos indígenas y comunidades rurales protegen el 80% de la biodiversidad remanente en el planeta. Demandan que la transición energética no sea un negocio corporativo de despojo territorial, sino un proceso de soberanía energética comunitaria donde la energía sea un bien común y no una mercancía especulativa.'
      }
    };

    const cards = document.querySelectorAll('.actor-card');
    const titleEl = document.getElementById('actor-detail-title');
    const tagEl = document.getElementById('actor-detail-tag');
    const textEl = document.getElementById('actor-detail-text');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const actor = card.getAttribute('data-actor') || '';
        cards.forEach(c => (c as HTMLElement).classList.remove('ring-2', 'ring-[#646cff]', 'border-[#646cff]'));
        card.classList.add('ring-2', 'ring-[#646cff]', 'border-[#646cff]');

        if (details[actor]) {
          if (titleEl) titleEl.textContent = details[actor].title;
          if (tagEl) tagEl.textContent = details[actor].tag;
          if (textEl) textEl.textContent = details[actor].text;
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupActorMatrix);
  document.addEventListener('astro:page-load', setupActorMatrix);
  setupActorMatrix();
</script>
