---
// CopSimulator.astro: Simulador Multilateral de Negociación COP (Estrategia 4)
---

<div class="not-content my-8 p-6 rounded-xl border border-[#2e2e32] bg-[#202127] shadow-sm cop-simulator">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-[#2e2e32]">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 uppercase tracking-wider">
          Simulación Computacional Heurística
        </span>
        <span class="text-xs text-[#a1a1aa]">Modelo Basado en IPCC AR6</span>
      </div>
      <h3 class="text-xl font-bold text-white m-0">Simulador Multilateral de la Cumbre Climática (COP)</h3>
      <p class="text-xs text-[#ebebf5] mt-1 mb-0">Ajusta los compromisos geopolíticos y observa el impacto en la temperatura y la justicia social</p>
    </div>
    <button type="button" id="btn-reset-cop" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-[#252529] hover:bg-[#252529] hover:border-[#646cff] border border-[#2e2e32] text-[#ebebf5] transition-all cursor-pointer">
      🔄 Restablecer Parámetros
    </button>
  </div>

  <!-- Indicadores en tiempo real -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
    <!-- Termómetro Global -->
    <div class="p-4 rounded-xl bg-[#252529] border border-[#2e2e32] flex items-center justify-between">
      <div>
        <span class="text-xs font-bold text-[#a1a1aa] uppercase tracking-wider block">Calentamiento Proyectado (2100)</span>
        <span id="display-temp" class="text-3xl font-black text-rose-400 transition-colors">+2.6 °C</span>
        <span class="block text-[11px] text-[#a1a1aa] mt-0.5">Meta París: &le; 1.5 °C</span>
      </div>
      <div class="text-3xl" id="icon-temp">🌡️</div>
    </div>

    <!-- Índice de Equidad Social -->
    <div class="p-4 rounded-xl bg-[#252529] border border-[#2e2e32] flex items-center justify-between">
      <div>
        <span class="text-xs font-bold text-[#a1a1aa] uppercase tracking-wider block">Índice de Equidad Social (Sur Global)</span>
        <span id="display-equity" class="text-3xl font-black text-amber-400 transition-colors">45%</span>
        <span class="block text-[11px] text-[#a1a1aa] mt-0.5">Meta Mínima: &ge; 70%</span>
      </div>
      <div class="text-3xl" id="icon-equity">⚖️</div>
    </div>
  </div>

  <!-- Controles / Deslizadores de Política -->
  <div class="space-y-4 mb-6">
    <!-- Slider 1 -->
    <div class="p-4 rounded-xl bg-[#252529] border border-[#2e2e32]">
      <div class="flex justify-between items-center mb-2">
        <label for="slider-coal" class="text-sm font-semibold text-white">
          1. Eliminación gradual de Carbón y Combustibles Fósiles
        </label>
        <span id="val-coal" class="text-sm font-bold text-emerald-400">30%</span>
      </div>
      <input type="range" id="slider-coal" min="0" max="100" value="30" class="w-full accent-[#646cff] cursor-pointer h-2 bg-[#202127] rounded-lg" />
      <div class="flex justify-between text-[10px] text-[#a1a1aa] mt-1">
        <span>0% (Negocio habitual)</span>
        <span>50% (Pacto de Glasgow)</span>
        <span>100% (Descarbonización total)</span>
      </div>
    </div>

    <!-- Slider 2 -->
    <div class="p-4 rounded-xl bg-[#252529] border border-[#2e2e32]">
      <div class="flex justify-between items-center mb-2">
        <label for="slider-renewables" class="text-sm font-semibold text-white">
          2. Inversión Global en Energías Renovables y Redes
        </label>
        <span id="val-renewables" class="text-sm font-bold text-indigo-400">40%</span>
      </div>
      <input type="range" id="slider-renewables" min="0" max="100" value="40" class="w-full accent-[#646cff] cursor-pointer h-2 bg-[#202127] rounded-lg" />
      <div class="flex justify-between text-[10px] text-[#a1a1aa] mt-1">
        <span>0% (Sin subsidios limpios)</span>
        <span>50% (Triplicar renovables 2030)</span>
        <span>100% (100% matriz solar/eólica)</span>
      </div>
    </div>

    <!-- Slider 3 -->
    <div class="p-4 rounded-xl bg-[#252529] border border-[#2e2e32]">
      <div class="flex justify-between items-center mb-2">
        <label for="slider-fund" class="text-sm font-semibold text-white">
          3. Fondo de Pérdidas y Daños (Transferencia Norte a Sur Global)
        </label>
        <span id="val-fund" class="text-sm font-bold text-purple-400">$100 MM USD/año</span>
      </div>
      <input type="range" id="slider-fund" min="0" max="500" step="25" value="100" class="w-full accent-[#646cff] cursor-pointer h-2 bg-[#202127] rounded-lg" />
      <div class="flex justify-between text-[10px] text-[#a1a1aa] mt-1">
        <span>$0 (Inacción financiera)</span>
        <span>$100 MM (Meta Copenhague)</span>
        <span>$500 MM (Demanda real de países vulnerables)</span>
      </div>
    </div>
  </div>

  <!-- Dictamen / Resolución de la Cumbre -->
  <div id="verdict-box" class="p-4 rounded-xl border border-rose-500/40 bg-rose-950/30 text-rose-200 text-sm mb-4 transition-all">
    <div class="font-bold flex items-center gap-2 mb-1" id="verdict-title">
      <span>⚠️</span> ALERTA DE CRISIS CLIMÁTICA Y SOCIAL
    </div>
    <p id="verdict-desc" class="text-xs text-[#ebebf5] m-0">
      Con estos parámetros, el planeta superará los +2.6 °C, provocando el deshielo de glaciares andinos y sequías severas. Además, la falta de financiamiento al Sur Global genera desigualdad crítica.
    </p>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
    <span class="text-xs text-[#a1a1aa]">Objetivo del Estudiante: Mantener la temperatura &le; 1.5 °C y la Equidad &ge; 70%.</span>
    <button type="button" id="btn-save-cop" class="px-4 py-2 text-xs font-bold rounded-xl bg-[#646cff] hover:bg-[#747bff] text-white flex items-center gap-1.5 transition-all cursor-pointer shadow-sm">
      <span>⭐</span> Guardar Desempeño en Pasaporte (+30 pts)
    </button>
  </div>
</div>

<script>
  function setupCopSimulator() {
    const sCoal = document.getElementById('slider-coal') as HTMLInputElement | null;
    const sRen = document.getElementById('slider-renewables') as HTMLInputElement | null;
    const sFund = document.getElementById('slider-fund') as HTMLInputElement | null;

    const vCoal = document.getElementById('val-coal');
    const vRen = document.getElementById('val-renewables');
    const vFund = document.getElementById('val-fund');

    const dTemp = document.getElementById('display-temp');
    const dEquity = document.getElementById('display-equity');
    const iTemp = document.getElementById('icon-temp');
    const iEquity = document.getElementById('icon-equity');

    const vBox = document.getElementById('verdict-box');
    const vTitle = document.getElementById('verdict-title');
    const vDesc = document.getElementById('verdict-desc');

    const btnReset = document.getElementById('btn-reset-cop');
    const btnSave = document.getElementById('btn-save-cop');

    if (!sCoal || !sRen || !sFund) return;

    function playSuccessSound() {
      try {
        const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.frequency.setValueAtTime(523.25, ctx.currentTime); // C5
        osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.1); // E5
        osc.frequency.setValueAtTime(783.99, ctx.currentTime + 0.2); // G5
        osc.frequency.setValueAtTime(1046.50, ctx.currentTime + 0.3); // C6
        gain.gain.setValueAtTime(0.15, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.6);
        osc.start();
        osc.stop(ctx.currentTime + 0.6);
      } catch (e) {}
    }

    function calculate() {
      const coal = parseFloat(sCoal?.value || '0');
      const ren = parseFloat(sRen?.value || '0');
      const fund = parseFloat(sFund?.value || '0');

      if (vCoal) vCoal.textContent = `${coal}%`;
      if (vRen) vRen.textContent = `${ren}%`;
      if (vFund) vFund.textContent = `$${fund} MM USD/año`;

      // Modelo matemático de reducción térmica
      const baseTemp = 3.3;
      const reduction = (coal * 0.011) + (ren * 0.007) + (fund / 500 * 0.15);
      const finalTemp = Math.max(1.3, Number((baseTemp - reduction).toFixed(1)));

      // Modelo de equidad social
      const equity = Math.min(100, Math.round(15 + (fund / 500 * 50) + (ren * 0.20) + (coal * 0.15)));

      if (dTemp) {
        dTemp.textContent = `+${finalTemp.toFixed(1)} °C`;
        if (finalTemp <= 1.5) {
          dTemp.className = 'text-3xl font-black text-emerald-400 transition-colors';
          if (iTemp) iTemp.textContent = '🌱';
        } else if (finalTemp <= 2.0) {
          dTemp.className = 'text-3xl font-black text-amber-400 transition-colors';
          if (iTemp) iTemp.textContent = '⛅';
        } else {
          dTemp.className = 'text-3xl font-black text-rose-400 transition-colors';
          if (iTemp) iTemp.textContent = '🔥';
        }
      }

      if (dEquity) {
        dEquity.textContent = `${equity}%`;
        if (equity >= 70) {
          dEquity.className = 'text-3xl font-black text-emerald-400 transition-colors';
          if (iEquity) iEquity.textContent = '🤝';
        } else if (equity >= 50) {
          dEquity.className = 'text-3xl font-black text-amber-400 transition-colors';
          if (iEquity) iEquity.textContent = '⚖️';
        } else {
          dEquity.className = 'text-3xl font-black text-rose-400 transition-colors';
          if (iEquity) iEquity.textContent = '⚠️';
        }
      }

      // Veredicto
      if (vBox && vTitle && vDesc) {
        if (finalTemp <= 1.5 && equity >= 70) {
          vBox.className = 'p-4 rounded-xl border border-emerald-500/50 bg-emerald-950/40 text-emerald-200 text-sm mb-4 transition-all';
          vTitle.innerHTML = '<span>🏆</span> ¡ACUERDO CLIMÁTICO HISTÓRICO ALCANZADO!';
          vDesc.textContent = '¡Excelente negociación multilateral! Lograste estabilizar la temperatura global en +1.5 °C protegiendo los medios de subsistencia y transfiriendo recursos justos al Sur Global.';
        } else if (finalTemp <= 1.5 && equity < 70) {
          vBox.className = 'p-4 rounded-xl border border-amber-500/50 bg-amber-950/40 text-amber-200 text-sm mb-4 transition-all';
          vTitle.innerHTML = '<span>⚠️</span> CONFLICTO SOCIAL: LA TRANSICIÓN ES INJUSTA';
          vDesc.textContent = 'Se reducen las emisiones térmicas, pero sin suficiente Fondo de Pérdidas y Daños, las naciones en desarrollo quedan condenadas al endeudamiento y la pobreza energética.';
        } else if (finalTemp > 1.5 && equity >= 70) {
          vBox.className = 'p-4 rounded-xl border border-amber-500/50 bg-amber-950/40 text-amber-200 text-sm mb-4 transition-all';
          vTitle.innerHTML = '<span>⚠️</span> COLAPSO ECOLÓGICO: CALENTAMIENTO EXCESIVO';
          vDesc.textContent = 'Hay buena solidaridad financiera, pero la velocidad de eliminación de carbón y petróleo es insuficiente para evitar puntos de no retorno planetarios.';
        } else {
          vBox.className = 'p-4 rounded-xl border border-rose-500/40 bg-rose-950/30 text-rose-200 text-sm mb-4 transition-all';
          vTitle.innerHTML = '<span>🚨</span> PARÁLISIS MULTILATERAL';
          vDesc.textContent = 'El calentamiento supera los 2.0 °C y la equidad social es baja. Ajusta los compromisos para alcanzar las metas del DBA de Ciencias Sociales.';
        }
      }
    }

    sCoal?.addEventListener('input', calculate);
    sRen?.addEventListener('input', calculate);
    sFund?.addEventListener('input', calculate);

    btnReset?.addEventListener('click', () => {
      if (sCoal) sCoal.value = '30';
      if (sRen) sRen.value = '40';
      if (sFund) sFund.value = '100';
      calculate();
    });

    btnSave?.addEventListener('click', () => {
      const coal = parseFloat(sCoal?.value || '0');
      const ren = parseFloat(sRen?.value || '0');
      const fund = parseFloat(sFund?.value || '0');
      const reduction = (coal * 0.011) + (ren * 0.007) + (fund / 500 * 0.15);
      const finalTemp = Math.max(1.3, Number((3.3 - reduction).toFixed(1)));
      const equity = Math.min(100, Math.round(15 + (fund / 500 * 50) + (ren * 0.20) + (coal * 0.15)));

      const currentScore = parseInt(localStorage.getItem('ova_clima_score') || '0', 10);
      const newScore = currentScore + 30;
      localStorage.setItem('ova_clima_score', newScore.toString());
      localStorage.setItem('ova_cop_completed', 'true');
      localStorage.setItem('ova_cop_temp', finalTemp.toString());
      localStorage.setItem('ova_cop_equity', equity.toString());

      playSuccessSound();
      alert(`¡Puntaje guardado en tu Pasaporte Climático! (+30 puntos)\nTemperatura lograda: +${finalTemp} °C\nEquidad Social: ${equity}%\nPuntaje acumulado: ${newScore} pts`);
    });

    calculate();
  }

  // Inicializar al cargar el DOM o cambiar de página en Starlight
  document.addEventListener('DOMContentLoaded', setupCopSimulator);
  setupCopSimulator();
</script>
